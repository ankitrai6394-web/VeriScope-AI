# ==========================================
# VeriScope AI - Environment Configuration Example
# Copy this file to .env and fill in your keys
# ==========================================

# Application Settings
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=True

# LLM Provider Configuration
# Supported providers: gemini, openai, mock (demo mode)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2

# Search Provider Configuration
# Supported providers: tavily, mock (demo mode)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_tavily_api_key_here
MAX_SEARCH_RESULTS_PER_QUERY=5

# Database Configuration
DATABASE_URL=sqlite:///./veriscope.db

# Security & Limits
MAX_RESEARCH_QUERY_LENGTH=500
MAX_CONCURRENT_AGENT_TASKS=4
HTTP_REQUEST_TIMEOUT_SECONDS=25
MAX_EXTERNAL_PAGE_DOWNLOAD_BYTES=1048576
