# Frontend Environment Configuration Example
# Copy this file to .env and adjust if needed

# Base API URL for backend calls.
# In local development, the Vite proxy redirects /api to http://127.0.0.1:8000
# In production on Render/Vercel, set this to your deployed backend service URL:
# Example: VITE_API_BASE_URL=https://veriscope-ai-backend.onrender.com/api
VITE_API_BASE_URL=
